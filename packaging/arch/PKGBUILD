# Maintainer: FeatherTex Contributors
pkgname=feathertex
pkgver=0.1.3
pkgrel=1
pkgdesc="Editor LaTeX leggero e moderno in Rust/Iced con anteprima PDF Poppler+Cairo, ricette, Outline e controllo qualità"
arch=('x86_64')
url="https://github.com/framrt/FeatherTex"
license=('GPL-3.0-or-later')
depends=(
  'gcc-libs'
  'hicolor-icon-theme'
)
makedepends=(
  'cargo'
)
optdepends=(
  'poppler-glib: anteprima PDF integrata ad alte prestazioni (caricata dinamicamente)'
  'cairo: backend grafico per anteprima PDF in-process'
  'poppler: fallback anteprima PDF esterna (pdftocairo/pdftoppm/pdfinfo)'
  'texlive-basic: compilazione pdfLaTeX'
  'texlive-latexrecommended: pacchetti accademici standard e natbib/booktabs'
  'texlive-binextra: texcount, chktex, latexdiff, latexmk e synctex'
  'texlive-mathscience: physics, siunitx, algorithm2e, ebproof'
  'biber: bibliografia moderna con biblatex'
  'hunspell: controllo ortografico LaTeX-aware'
  'hunspell-it: dizionario italiano per hunspell'
  'hunspell-en_us: dizionario inglese US per hunspell'
  'wl-clipboard: supporto appunti su Wayland'
)
options=('!lto')

# Per una build da sorgenti remoti (AUR/GitHub Release):
# source=("$pkgname-$pkgver.tar.gz::https://github.com/<USER>/<REPO>/archive/v$pkgver.tar.gz")
# sha256sums=('SKIP')

_project_root="${startdir}/../.."

build() {
  cd "$_project_root"
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR="$srcdir/target"
  cargo build --release --locked
}

package() {
  install -Dm755 "$srcdir/target/release/feathertex" \
    "$pkgdir/usr/bin/feathertex"

  install -Dm644 "$_project_root/packaging/linux/feathertex.desktop" \
    "$pkgdir/usr/share/applications/feathertex.desktop"

  install -Dm644 "$_project_root/assets/feathertex-512.png" \
    "$pkgdir/usr/share/icons/hicolor/512x512/apps/feathertex.png"
  install -Dm644 "$_project_root/assets/feathertex-256.png" \
    "$pkgdir/usr/share/icons/hicolor/256x256/apps/feathertex.png"
  install -Dm644 "$_project_root/assets/feathertex-128.png" \
    "$pkgdir/usr/share/icons/hicolor/128x128/apps/feathertex.png"

  install -dm755 "$pkgdir/usr/share/feathertex/demo/chapters"
  install -Dm644 "$_project_root/demo/main.tex" \
    "$pkgdir/usr/share/feathertex/demo/main.tex"
  install -Dm644 "$_project_root/demo/references.bib" \
    "$pkgdir/usr/share/feathertex/demo/references.bib"
  install -Dm644 "$_project_root/demo/chapters/intro.tex" \
    "$pkgdir/usr/share/feathertex/demo/chapters/intro.tex"
  install -Dm644 "$_project_root/demo/chapters/results.tex" \
    "$pkgdir/usr/share/feathertex/demo/chapters/results.tex"
}

