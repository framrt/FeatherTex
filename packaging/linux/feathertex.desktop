[Desktop Entry]
Type=Application
Name=FeatherTex
GenericName=Editor LaTeX Scientifico
Comment=Editor LaTeX veloce con anteprima PDF istantanea, ricette di compilazione, Outline e strumenti per la ricerca
Exec=feathertex %f
Icon=feathertex
Terminal=false
Categories=Office;Publishing;Science;Education;
